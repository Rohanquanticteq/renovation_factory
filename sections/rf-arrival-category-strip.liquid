{{ 'rf-arrival-category-strip.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_section -%}
  <section
    class="rf-arrival-category-strip"
    aria-label="{{ section.settings.accessibility_label | escape }}"
    {{ section.shopify_attributes }}
  >
    <div class="rf-arrival-category-strip__rail" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign desktop_image = block.settings.desktop_image
          assign mobile_image = block.settings.mobile_image | default: desktop_image
          if desktop_image == blank
            assign desktop_image = mobile_image
          endif
        -%}

        {%- capture card_classes -%}
          rf-arrival-category-strip__card
          {%- if block.settings.desktop_image_includes_text %} rf-arrival-category-strip__card--desktop-artwork{% endif -%}
          {%- if block.settings.mobile_image_includes_text %} rf-arrival-category-strip__card--mobile-artwork{% endif -%}
        {%- endcapture -%}

        {%- if block.settings.link != blank -%}
          <a
            class="{{ card_classes | strip }}"
            href="{{ block.settings.link }}"
            role="listitem"
            {{ block.shopify_attributes }}
          >
        {%- else -%}
          <div
            class="{{ card_classes | strip }}"
            role="listitem"
            {{ block.shopify_attributes }}
          >
        {%- endif -%}

          <div class="rf-arrival-category-strip__media">
            {%- if desktop_image != blank -%}
              <picture>
                {%- if mobile_image != blank -%}
                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {{ mobile_image | image_url: width: 450 }} 450w,
                      {{ mobile_image | image_url: width: 700 }} 700w,
                      {{ mobile_image | image_url: width: 900 }} 900w
                    "
                    sizes="78vw"
                  >
                {%- endif -%}

                {{
                  desktop_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'rf-arrival-category-strip__image',
                    widths: '400, 600, 800, 1000, 1200',
                    sizes: '(min-width: 750px) 25vw, 78vw',
                    loading: 'lazy',
                    alt: block.settings.image_alt
                }}
              </picture>
            {%- else -%}
              <div class="rf-arrival-category-strip__placeholder" aria-hidden="true"></div>
            {%- endif -%}
          </div>

          <span class="rf-arrival-category-strip__shade" aria-hidden="true"></span>

          <div class="rf-arrival-category-strip__content">
            {%- if block.settings.title != blank -%}
              <h2 class="rf-arrival-category-strip__title">{{ block.settings.title | escape }}</h2>
            {%- endif -%}

            {%- if block.settings.cta_label != blank -%}
              <span class="rf-arrival-category-strip__cta">
                {{ block.settings.cta_label | escape }}
                <span aria-hidden="true">&rarr;</span>
              </span>
            {%- endif -%}
          </div>

        {%- if block.settings.link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "RF Arrival category strip",
  "class": "shopify-section--rf-arrival-category-strip",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Shop by category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "checkbox",
          "id": "desktop_image_includes_text",
          "label": "Desktop image already includes text",
          "info": "Turn this on when the desktop artwork already contains the category title and Shop Now text. The separate HTML text and overlay will be hidden on desktop.",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "checkbox",
          "id": "mobile_image_includes_text",
          "label": "Mobile image already includes text",
          "info": "Turn this on when the mobile artwork already contains the category title and Shop Now text. The separate HTML text and overlay will be hidden on mobile.",
          "default": false
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RF Arrival category strip",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "LIGHTING",
            "cta_label": "SHOP NOW"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "FURNITURE",
            "cta_label": "SHOP NOW"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "DECOR",
            "cta_label": "SHOP NOW"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "TABLE TOP & BAR",
            "cta_label": "SHOP NOW"
          }
        }
      ]
    }
  ]
}
{% endschema %}
