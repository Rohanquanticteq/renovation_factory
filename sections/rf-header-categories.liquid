{{ 'rf-header-categories.css' | asset_url | stylesheet_tag }}
<script src="{{ 'rf-header-categories.js' | asset_url }}" defer="defer"></script>

{%- if request.page_type == 'index' and section.settings.show_section and section.blocks.size > 0 -%}
  <nav
    class="rf-header-categories"
    aria-label="{{ section.settings.accessibility_label | escape }}"
    {{ section.shopify_attributes }}
  >
    <h2 class="rf-header-categories__heading">{{ section.settings.heading | escape }}</h2>
    <div class="rf-header-categories__grid">
      {%- for block in section.blocks -%}
        <a
          class="rf-header-categories__tile"
          href="{{ block.settings.link | default: routes.all_products_collection_url }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {%- liquid
              assign image_loading = 'eager'
              assign image_priority = 'auto'
              if forloop.first
                assign image_priority = 'high'
              endif
            -%}
            {{
              block.settings.image
              | image_url: width: 1000
              | image_tag:
                class: 'rf-header-categories__image',
                widths: '320, 480, 640, 800, 1000',
                sizes: '25vw',
                loading: image_loading,
                fetchpriority: image_priority,
                alt: block.settings.image_alt
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'rf-header-categories__image rf-header-categories__placeholder' }}
          {%- endif -%}

          <span class="rf-header-categories__shade" aria-hidden="true"></span>
          <span class="rf-header-categories__content">
            <span class="rf-header-categories__title">{{ block.settings.title | escape }}</span>
            {%- if block.settings.link_label != blank -%}
              <span class="rf-header-categories__link">
                {{ block.settings.link_label | escape }}
                <span aria-hidden="true">&rarr;</span>
              </span>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </nav>
{%- endif -%}

{% schema %}
{
  "name": "RF Header categories",
  "class": "shopify-section--rf-header-categories",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show on homepage",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Mobile heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Shop by category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "category", "settings": { "title": "Lighting" } },
      { "type": "category", "settings": { "title": "Furniture" } },
      { "type": "category", "settings": { "title": "Décor" } },
      { "type": "category", "settings": { "title": "Table Top & Bar" } }
    ]
  }
}
{% endschema %}
