{% if section.settings.display_text_btn_sec_2 != blank %}
<div class="textWithBtnSec textWithBtnSec_2">
  <div class="inner_d">
    <div class="desc_d">{{ section.settings.title }}</div>
    {% if section.settings.app_button != blank %}
    <div class="action_btn_app">
    {{ section.settings.app_button }}
    </div>
    {% endif %}
    
    {% if section.settings.button_text != blank %}
    <div class="action_btn">
      <a href="{{ section.settings.button_link }}" class="btn button11">{{ section.settings.button_text }}</a>
    </div>
      {% endif %}
  </div>
</div>
{% endif %}


{% schema %}
{
  "name": "Text Btn Sec 2",
  "class": "section",
  "settings": [
     {
        "type": "checkbox",
        "id": "display_text_btn_sec_2",
        "label": "Display Text Btn Sec 2",
        "default": true
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "app_button",
      "label": "App Button Text"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Text Btn Sec 2"
    }
  ]
}
{% endschema %}
