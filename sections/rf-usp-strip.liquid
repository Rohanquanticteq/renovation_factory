{{ 'rf-usp-strip.css' | asset_url | stylesheet_tag }}

<section
  class="rf-usp-strip"
  aria-label="{{ section.settings.accessibility_label | escape }}"
  {{ section.shopify_attributes }}
>
  <div class="rf-usp-strip__grid">
    {%- for block in section.blocks -%}
      <div class="rf-usp-strip__item" {{ block.shopify_attributes }}>
        <span class="rf-usp-strip__icon" aria-hidden="true">
          {%- if block.settings.custom_icon != blank -%}
            {{
              block.settings.custom_icon
              | image_url: width: 120
              | image_tag:
                class: 'rf-usp-strip__icon-image',
                widths: '40, 60, 80, 120',
                sizes: '40px',
                loading: 'lazy',
                alt: ''
            }}
          {%- else -%}
            {%- case block.settings.icon -%}
              {%- when 'shipping' -%}
                <svg viewBox="0 0 40 40" role="presentation">
                  <path d="M5 11h19v17H5zM24 17h6l5 6v5H24zM11 31a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm18 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/>
                </svg>
              {%- when 'guidance' -%}
                <svg viewBox="0 0 40 40" role="presentation">
                  <path d="M11 21v-3a9 9 0 0 1 18 0v3M8 20h4v9H8a3 3 0 0 1-3-3v-3a3 3 0 0 1 3-3Zm24 0h-4v9h4a3 3 0 0 0 3-3v-3a3 3 0 0 0-3-3ZM28 29c-1 4-4 6-8 6"/>
                </svg>
              {%- when 'packaging' -%}
                <svg viewBox="0 0 40 40" role="presentation">
                  <path d="m20 5 13 7-13 7-13-7 13-7Zm-13 7v16l13 7 13-7V12M20 19v16"/>
                </svg>
              {%- when 'quality' -%}
                <svg viewBox="0 0 40 40" role="presentation">
                  <path d="M20 5 32 9v9c0 8-5 14-12 17-7-3-12-9-12-17V9l12-4Z"/>
                  <path d="m14 20 4 4 8-9"/>
                </svg>
              {%- when 'installation' -%}
                <svg viewBox="0 0 40 40" role="presentation">
                  <path d="M20 5 25 9l6-1 1 6 4 5-4 5-1 6-6-1-5 4-5-4-6 1-1-6-4-5 4-5 1-6 6 1 5-4Z"/>
                  <path d="m15 20 3 3 7-7"/>
                </svg>
            {%- endcase -%}
          {%- endif -%}
        </span>

        {%- if block.settings.text != blank -%}
          <p class="rf-usp-strip__text">{{ block.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "RF USP strip",
  "tag": "section",
  "class": "shopify-section--rf-usp-strip",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Renovation Factory service benefits"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "settings": [
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon image",
          "info": "Upload a PNG from Canva. When set, this image replaces the built-in icon below."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Built-in icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "guidance", "label": "Expert guidance" },
            { "value": "packaging", "label": "Packaging" },
            { "value": "quality", "label": "Quality" },
            { "value": "installation", "label": "Installation" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping across India"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RF USP strip",
      "blocks": [
        {
          "type": "usp",
          "settings": {
            "icon": "shipping",
            "text": "Free shipping across India"
          }
        },
        {
          "type": "usp",
          "settings": {
            "icon": "guidance",
            "text": "Expert guidance for your space"
          }
        },
        {
          "type": "usp",
          "settings": {
            "icon": "packaging",
            "text": "Secure packaging"
          }
        },
        {
          "type": "usp",
          "settings": {
            "icon": "quality",
            "text": "Quality you can trust, crafted to last"
          }
        },
        {
          "type": "usp",
          "settings": {
            "icon": "installation",
            "text": "Installation support"
          }
        }
      ]
    }
  ]
}
{% endschema %}
