      "label": "Brand name",
      "default": "RENOVATION FACTORY"
    },
    {
      "type": "richtext",
      "id": "brand_tagline",
      "label": "Brand tagline",
      "default": "<p>Timeless designs. Thoughtfully crafted. Made for the way you live.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_social_media",
      "label": "Show social media",
      "default": true
    },
    {
      "type": "header",
      "content": "Journal promo"
    },
    {
      "type": "text",
      "id": "journal_heading",
      "label": "Heading",
      "default": "THE JOURNAL"
    },
    {
      "type": "richtext",
      "id": "journal_text",
      "label": "Text",
      "default": "<p>Inspiration for a beautiful life.</p>"
    },
    {
      "type": "text",
      "id": "journal_link_label",
      "label": "Link label",
      "default": "EXPLORE NOW"
    },
    {
      "type": "url",
      "id": "journal_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Copyright name"
    },
    {
      "type": "text",
      "id": "copyright_suffix",
      "label": "Copyright suffix",
      "default": "All Rights Reserved."
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal menu"
    },
    {
      "type": "page",
      "id": "accessibility_page",
      "label": "Accessibility page"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#151311"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#F7F2EA"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text",
      "default": "#C9C1B8"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#3B3631"
    },
    {
      "type": "header",
      "content": "Optional extras"
    },
    {
      "type": "checkbox",
      "id": "show_payment_methods",
      "label": "Show payment methods",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "Show country/region selector",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_locale_selector",
      "label": "Show language selector",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading override"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "links_with_logo",
      "name": "Two menu columns (legacy)",
      "settings": [
        {
          "type": "image_picker",
          "id": "footer_logo",
          "label": "Legacy footer logo"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu 1"
        },
        {
          "type": "link_list",
          "id": "menu_2",
