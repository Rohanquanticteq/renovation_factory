{{ 'rf-footer.css' | asset_url | stylesheet_tag }}

<footer
  id="section-{{ section.id }}"
  class="RF-Footer"
  data-section-id="{{ section.id }}"
  data-section-type="footer"
  role="contentinfo"
  style="
    --rf-footer-background: {{ section.settings.background_color }};
    --rf-footer-text: {{ section.settings.text_color }};
    --rf-footer-muted: {{ section.settings.muted_text_color }};
    --rf-footer-border: {{ section.settings.border_color }};
  "
>
  <div class="RF-Footer__Main">
    <div class="RF-Footer__Brand">
      <a class="RF-Footer__BrandLink" href="{{ routes.root_url }}">
        {%- if section.settings.brand_logo != blank -%}
          {{
            section.settings.brand_logo
            | image_url: width: 360
            | image_tag:
              class: 'RF-Footer__Logo',
              widths: '140, 220, 360',
              sizes: '150px',
              loading: 'lazy',
              alt: section.settings.brand_logo.alt
          }}
        {%- elsif section.settings.brand_name != blank -%}
          <span class="RF-Footer__BrandName">{{ section.settings.brand_name | escape }}</span>
        {%- else -%}
          <span class="RF-Footer__BrandName">{{ shop.name | escape }}</span>
        {%- endif -%}
      </a>

      {%- if section.settings.brand_tagline != blank -%}
        <div class="RF-Footer__Tagline Rte">
          {{ section.settings.brand_tagline }}
        </div>
      {%- endif -%}

      {%- if section.settings.show_social_media -%}
        <div class="RF-Footer__SocialWrap">
          {% render 'social-media', class: 'RF-Footer__Social', spacing: 'loose' %}
        </div>
      {%- endif -%}
    </div>

    <div class="RF-Footer__Menus">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'links' -%}
            {%- assign linklist = linklists[block.settings.menu] -%}
            {%- if linklist != blank -%}
              <div class="RF-Footer__MenuColumn" {{ block.shopify_attributes }}>
                <h2 class="RF-Footer__MenuTitle">
                  {%- if block.settings.heading != blank -%}
                    {{ block.settings.heading | escape }}
                  {%- else -%}
                    {{ linklist.title | escape }}
                  {%- endif -%}
                </h2>

                <ul class="RF-Footer__MenuList" role="list">
                  {%- for link in linklist.links -%}
                    <li class="RF-Footer__MenuItem">
                      <a class="RF-Footer__MenuLink" href="{{ link.url }}">
                        {{ link.title | escape }}
                      </a>

                      {%- if link.links != blank -%}
                        <ul class="RF-Footer__Submenu" role="list">
                          {%- for child_link in link.links -%}
                            <li>
                              <a class="RF-Footer__MenuLink" href="{{ child_link.url }}">
                                {{ child_link.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

          {%- when 'links_with_logo' -%}
            <div class="RF-Footer__LegacyMenus" {{ block.shopify_attributes }}>
              {%- assign linklist_one = linklists[block.settings.menu] -%}
              {%- assign linklist_two = linklists[block.settings.menu_2] -%}

              {%- if linklist_one != blank -%}
                <div class="RF-Footer__MenuColumn">
                  <h2 class="RF-Footer__MenuTitle">{{ linklist_one.title | escape }}</h2>
                  <ul class="RF-Footer__MenuList" role="list">
                    {%- for link in linklist_one.links -%}
                      <li><a class="RF-Footer__MenuLink" href="{{ link.url }}">{{ link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}

              {%- if linklist_two != blank -%}
                <div class="RF-Footer__MenuColumn">
                  <h2 class="RF-Footer__MenuTitle">{{ linklist_two.title | escape }}</h2>
                  <ul class="RF-Footer__MenuList" role="list">
                    {%- for link in linklist_two.links -%}
                      <li><a class="RF-Footer__MenuLink" href="{{ link.url }}">{{ link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
            </div>

          {%- when 'text' -%}
            <div class="RF-Footer__TextColumn" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h2 class="RF-Footer__MenuTitle">{{ block.settings.title | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.content != blank -%}
                <div class="RF-Footer__TextContent Rte">{{ block.settings.content }}</div>
              {%- endif -%}
            </div>

          {%- when 'newsletter' -%}
            <div class="RF-Footer__Newsletter" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h2 class="RF-Footer__MenuTitle">{{ block.settings.title | escape }}</h2>
              {%- endif -%}

              {%- if block.settings.content != blank -%}
                <div class="RF-Footer__TextContent Rte">{{ block.settings.content }}</div>
              {%- endif -%}

              {%- form 'customer', id: 'rf-footer-newsletter', class: 'RF-Footer__NewsletterForm' -%}
                {%- if form.posted_successfully? -%}
                  <p class="RF-Footer__FormMessage">{{ 'footer.newsletter.success' | t }}</p>
                {%- else -%}
                  {%- if form.errors -%}
                    <p class="RF-Footer__FormMessage">{{ form.errors.messages['email'] }}</p>
                  {%- endif -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <label class="u-visually-hidden" for="RF-FooterEmail-{{ section.id }}">
                    {{ 'footer.newsletter.input' | t }}
                  </label>
                  <div class="RF-Footer__NewsletterRow">
                    <input
                      id="RF-FooterEmail-{{ section.id }}"
                      type="email"
                      name="contact[email]"
                      class="RF-Footer__NewsletterInput"
                      placeholder="{{ 'footer.newsletter.input' | t }}"
                      required
                    >
                    <button type="submit" class="RF-Footer__NewsletterButton">
                      {{ block.settings.button_label | escape }}
                    </button>
                  </div>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="RF-Footer__Journal">
      {%- if section.settings.journal_heading != blank -%}
        <h2 class="RF-Footer__JournalHeading">{{ section.settings.journal_heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.journal_text != blank -%}
        <div class="RF-Footer__JournalText Rte">{{ section.settings.journal_text }}</div>
      {%- endif -%}

      {%- if section.settings.journal_link_label != blank -%}
        <a
          class="RF-Footer__JournalLink"
          {% if section.settings.journal_link != blank %}
            href="{{ section.settings.journal_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          {{ section.settings.journal_link_label | escape }}
          <span aria-hidden="true">&rarr;</span>
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="RF-Footer__Bottom">
    <p class="RF-Footer__Copyright">
      &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_name | default: shop.name | escape }}.
      {%- if section.settings.copyright_suffix != blank -%}
        &nbsp;{{ section.settings.copyright_suffix | escape }}
      {%- endif -%}
    </p>

    <nav class="RF-Footer__Legal" aria-label="Footer legal">
      {%- assign legal_menu = linklists[section.settings.legal_menu] -%}
      {%- if legal_menu != blank -%}
        {%- for link in legal_menu.links -%}
          <a href="{{ link.url }}">{{ link.title | escape }}</a>
        {%- endfor -%}
      {%- else -%}
        {%- if shop.privacy_policy != blank -%}
          <a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title | escape }}</a>
        {%- endif -%}
        {%- if shop.terms_of_service != blank -%}
          <a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title | escape }}</a>
        {%- endif -%}
        {%- if section.settings.accessibility_page != blank -%}
          <a href="{{ section.settings.accessibility_page.url }}">{{ section.settings.accessibility_page.title | escape }}</a>
        {%- endif -%}
      {%- endif -%}
    </nav>
  </div>

  {%- if section.settings.show_country_selector or section.settings.show_locale_selector or section.settings.show_payment_methods -%}
    <div class="RF-Footer__Extras">
      {%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
        {%- form 'localization', id: 'rf_footer_country_form', class: 'RF-Footer__LocalizationForm' -%}
          <label class="u-visually-hidden" for="RF-FooterCountry-{{ section.id }}">{{ 'footer.general.country' | t }}</label>
          <select id="RF-FooterCountry-{{ section.id }}" name="country_code" onchange="this.form.submit()">
            {%- for country in localization.available_countries -%}
              <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                {{ country.name }} ({{ country.currency.iso_code }})
              </option>
            {%- endfor -%}
          </select>
        {%- endform -%}
      {%- endif -%}

      {%- if section.settings.show_locale_selector and localization.available_languages.size > 1 -%}
        {%- form 'localization', id: 'rf_footer_locale_form', class: 'RF-Footer__LocalizationForm' -%}
          <label class="u-visually-hidden" for="RF-FooterLocale-{{ section.id }}">{{ 'footer.general.locale' | t }}</label>
          <select id="RF-FooterLocale-{{ section.id }}" name="locale_code" onchange="this.form.submit()">
            {%- for language in localization.available_languages -%}
              <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                {{ language.endonym_name | capitalize }}
              </option>
            {%- endfor -%}
          </select>
        {%- endform -%}
      {%- endif -%}

      {%- if section.settings.show_payment_methods -%}
        <ul class="RF-Footer__Payments" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  {%- endif -%}
</footer>

<div class="footerStickyText" id="footerStickyText">
  <div class="footerStickyText__track" id="footerStickyTrack">
    <div class="save__text footerStickyText__slide is-active">RF 10% OFF sitewide <button contactform-trigger="418600"></button></div>
    <div class="save__text footerStickyText__slide">
      <a href="https://www.google.com/maps/place/Renovation+Facttory/@28.5074273,77.0869705,17z/data=!4m15!1m8!3m7!1s0x390d1944cb9b0e49:0xb81886ab8996fd0b!2s298,+Udyog+Vihar+II+Rd,+Phase+II,+Udyog+Vihar,+Sector+20,+Gurugram,+Haryana+122016!3b1!8m2!3d28.5074273!4d77.0869705!16s%2Fg%2F11snpzzmvv!3m5!1s0x390d199c79c24a95:0x2fe5dea2d0be374b!8m2!3d28.5076099!4d77.0870975!16s%2Fg%2F11smdp5gcm?entry=ttu&g_ep=EgoyMDI1MTEyMy4xIKXMDSoASAFQAw%3D%3D" target="_blank" rel="noopener" class="footerStickyText__gallery-link">
        <img src="https://cdn.shopify.com/s/files/1/0576/3907/5997/files/maps-and-flags_1.svg?v=1788859199" alt="" class="footerStickyText__gallery-icon">
        Visit Gallery
      </a>
    </div>
  </div>
  <button class="close_btn" id="closeBtn11" type="button" aria-label="Close promotion">X</button>
</div>

<script>
(function () {
  var footerDiv = document.getElementById('footerStickyText');
  var closeButton = document.getElementById('closeBtn11');
  var slides = document.querySelectorAll('#footerStickyTrack .footerStickyText__slide');

  if (!footerDiv) return;

  function hideFooter() {
    footerDiv.style.display = 'none';
  }

  function checkFooterVisibility() {
    var lastClosed = localStorage.getItem('footerClosedTime');
    var now = new Date().getTime();
    var twoHours = 2 * 60 * 60 * 1000;

    if (lastClosed && (now - lastClosed) < twoHours) {
      hideFooter();
    }
  }

  if (closeButton) {
    closeButton.addEventListener('click', function () {
      localStorage.setItem('footerClosedTime', new Date().getTime());
      hideFooter();
    });
  }

  checkFooterVisibility();

  if (slides.length > 1) {
    var current = 0;
    setInterval(function () {
      current = (current + 1) % slides.length;
      slides.forEach(function (slide, index) {
        slide.classList.toggle('is-active', index === current);
      });
    }, 4000);
  }
})();
</script>

{% schema %}
{
  "name": "Footer",
  "class": "shopify-section--footer",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Brand"
