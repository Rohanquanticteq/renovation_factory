{{ 'rf-arrival-editorial-showcase.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_section -%}
  <section
    class="rf-arrival-editorial-showcase{% if section.settings.desktop_images_include_text %} rf-arrival-editorial-showcase--desktop-artwork{% endif %}{% if section.settings.mobile_images_include_text %} rf-arrival-editorial-showcase--mobile-artwork{% endif %}"
    aria-label="{{ section.settings.accessibility_label | escape }}"
    {{ section.shopify_attributes }}
  >
    <div class="rf-arrival-editorial-showcase__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign desktop_image = block.settings.desktop_image
          assign mobile_image = block.settings.mobile_image | default: desktop_image
          if desktop_image == blank
            assign desktop_image = mobile_image
          endif

          assign heading_text = block.settings.heading
          assign subheading_text = block.settings.subheading

          if subheading_text == blank and heading_text contains '\\N'
            assign heading_parts = heading_text | split: '\\N'
            assign heading_text = heading_parts | first
            assign subheading_text = heading_parts | last
          elsif subheading_text == blank and heading_text contains '\\n'
            assign heading_parts = heading_text | split: '\\n'
            assign heading_text = heading_parts | first
            assign subheading_text = heading_parts | last
          endif
        -%}

        <div
          class="rf-arrival-editorial-showcase__panel rf-arrival-editorial-showcase__panel--{{ block.settings.layout_style }} rf-arrival-editorial-showcase__panel--{{ block.settings.text_tone }}{% if block.settings.desktop_image_includes_text %} rf-arrival-editorial-showcase__panel--desktop-artwork{% endif %}{% if block.settings.mobile_image_includes_text %} rf-arrival-editorial-showcase__panel--mobile-artwork{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.link != blank -%}
            <a class="rf-arrival-editorial-showcase__link" href="{{ block.settings.link }}">
          {%- endif -%}

          <div class="rf-arrival-editorial-showcase__media">
            {%- if desktop_image != blank -%}
              <picture>
                {%- if mobile_image != blank -%}
                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {{ mobile_image | image_url: width: 500 }} 500w,
                      {{ mobile_image | image_url: width: 750 }} 750w,
                      {{ mobile_image | image_url: width: 1000 }} 1000w
                    "
                    sizes="100vw"
                  >
                {%- endif -%}
                {{
                  desktop_image
                  | image_url: width: 1800
                  | image_tag:
                    class: 'rf-arrival-editorial-showcase__image',
                    widths: '500, 750, 1000, 1300, 1600, 1800',
                    sizes: '(min-width: 750px) 40vw, 100vw',
                    loading: 'lazy',
                    alt: block.settings.image_alt
                }}
              </picture>
            {%- else -%}
              <div class="rf-arrival-editorial-showcase__placeholder" aria-hidden="true"></div>
            {%- endif -%}
          </div>

          <div class="rf-arrival-editorial-showcase__content">
            {%- if block.settings.eyebrow != blank -%}
              <p class="rf-arrival-editorial-showcase__eyebrow">{{ block.settings.eyebrow | escape }}</p>
            {%- endif -%}

            {%- if heading_text != blank -%}
              <h2 class="rf-arrival-editorial-showcase__heading">{{ heading_text | escape }}</h2>
            {%- endif -%}

            {%- if subheading_text != blank -%}
              <p class="rf-arrival-editorial-showcase__subheading">{{ subheading_text | escape }}</p>
            {%- endif -%}

            {%- if block.settings.body != blank -%}
              <div class="rf-arrival-editorial-showcase__body">{{ block.settings.body }}</div>
            {%- endif -%}

            {%- if block.settings.cta_label != blank -%}
              <span class="rf-arrival-editorial-showcase__cta">
                {{ block.settings.cta_label | escape }}
                <span aria-hidden="true">&rarr;</span>
              </span>
            {%- endif -%}
          </div>

          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "RF Arrival editorial",
  "class": "shopify-section--rf-arrival-editorial",
  "max_blocks": 3,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "desktop_images_include_text",
      "label": "Desktop images already include text",
      "info": "Turn this on when all three desktop artworks already contain their text and CTA. Dynamic HTML content will be hidden and each image will fill its panel.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "mobile_images_include_text",
      "label": "Mobile images already include text",
      "info": "Turn this on when all three mobile artworks already contain their text and CTA.",
      "default": false
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Featured collections"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature panel",
      "settings": [
        {
          "type": "select",
          "id": "layout_style",
          "label": "Layout style",
          "options": [
            {
              "value": "split-left",
              "label": "Text panel left, image right"
            },
            {
              "value": "overlay-top",
              "label": "Text over image, top"
            },
            {
              "value": "overlay-bottom",
              "label": "Text over image, bottom"
            }
          ],
          "default": "overlay-top"
        },
        {
          "type": "select",
          "id": "text_tone",
          "label": "Text tone",
          "options": [
            {
              "value": "dark",
              "label": "Dark"
            },
            {
              "value": "light",
              "label": "Light"
            }
          ],
          "default": "dark"
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "checkbox",
          "id": "desktop_image_includes_text",
          "label": "This desktop image already includes text",
          "info": "Use this only when this individual desktop panel already contains all of its text and CTA.",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "checkbox",
          "id": "mobile_image_includes_text",
          "label": "This mobile image already includes text",
          "info": "Use this only when this individual mobile panel already contains all of its text and CTA.",
          "default": false
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Primary heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Secondary heading"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RF Arrival editorial",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "layout_style": "split-left",
            "text_tone": "dark",
            "eyebrow": "FEATURED",
            "heading": "DRINK",
            "subheading": "TABLES",
            "body": "<p>Sculptural details for every corner</p>",
            "cta_label": "EXPLORE DRINK TABLES"
          }
        },
        {
          "type": "feature",
          "settings": {
            "layout_style": "overlay-top",
            "text_tone": "dark",
            "heading": "ORBIT",
            "subheading": "SCULPTURE",
            "body": "<p>RIBBONS OF BRONZE<br>RESTING ON MARBLE</p>",
            "cta_label": "EXPLORE DECOR"
          }
        },
        {
          "type": "feature",
          "settings": {
            "layout_style": "overlay-bottom",
            "text_tone": "dark",
            "heading": "FLARE",
            "subheading": "WALL SCONCE",
            "cta_label": "EXPLORE WALL LIGHTS"
          }
        }
      ]
    }
  ]
}
{% endschema %}
