{{ 'rf-arrival-editorial-showcase.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_section -%}
  <section
    class="rf-arrival-editorial-showcase{% if section.settings.desktop_images_include_text %} rf-arrival-editorial-showcase--desktop-artwork{% endif %}{% if section.settings.mobile_images_include_text %} rf-arrival-editorial-showcase--mobile-artwork{% endif %}"
    aria-label="{{ section.settings.accessibility_label | escape }}"
    {{ section.shopify_attributes }}
  >
    <div class="rf-arrival-editorial-showcase__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign desktop_video = block.settings.desktop_video
          assign mobile_video = block.settings.mobile_video
          assign desktop_image = block.settings.desktop_image
          assign mobile_image = block.settings.mobile_image | default: desktop_image
          if desktop_image == blank
            assign desktop_image = mobile_image
          endif

          assign heading_text = block.settings.heading
          assign subheading_text = block.settings.subheading

          if subheading_text == blank and heading_text contains '\\N'
            assign heading_parts = heading_text | split: '\\N'
            assign heading_text = heading_parts | first
            assign subheading_text = heading_parts | last
          elsif subheading_text == blank and heading_text contains '\\n'
            assign heading_parts = heading_text | split: '\\n'
            assign heading_text = heading_parts | first
            assign subheading_text = heading_parts | last
          endif
        -%}

        <div
          class="rf-arrival-editorial-showcase__panel rf-arrival-editorial-showcase__panel--{{ block.settings.layout_style }} rf-arrival-editorial-showcase__panel--{{ block.settings.text_tone }}{% if block.settings.desktop_image_includes_text %} rf-arrival-editorial-showcase__panel--desktop-artwork{% endif %}{% if block.settings.mobile_image_includes_text %} rf-arrival-editorial-showcase__panel--mobile-artwork{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.link != blank -%}
            <a class="rf-arrival-editorial-showcase__link" href="{{ block.settings.link }}">
          {%- endif -%}

          <div class="rf-arrival-editorial-showcase__media">
            <div class="rf-arrival-editorial-showcase__media-desktop">
              {%- if desktop_video != blank -%}
                <video
                  class="rf-arrival-editorial-showcase__video"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  {%- if desktop_image != blank %} poster="{{ desktop_image | image_url: width: 1400 }}"{% endif -%}
                >
                  {%- for source in desktop_video.sources -%}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {%- endfor -%}
                  {%- if desktop_image != blank -%}
                    {{
                      desktop_image
                      | image_url: width: 1400
                      | image_tag:
                        class: 'rf-arrival-editorial-showcase__image',
                        widths: '500, 750, 1000, 1200, 1400',
                        sizes: '(min-width: 750px) 40vw, 100vw',
                        loading: 'lazy',
                        alt: block.settings.image_alt
                    }}
                  {%- endif -%}
                </video>
              {%- elsif desktop_image != blank -%}
                {{
                  desktop_image
                  | image_url: width: 1800
                  | image_tag:
                    class: 'rf-arrival-editorial-showcase__image',
                    widths: '500, 750, 1000, 1300, 1600, 1800',
                    sizes: '(min-width: 750px) 40vw, 100vw',
                    loading: 'lazy',
                    alt: block.settings.image_alt
                }}
              {%- else -%}
                <div class="rf-arrival-editorial-showcase__placeholder" aria-hidden="true"></div>
              {%- endif -%}
            </div>

            <div class="rf-arrival-editorial-showcase__media-mobile">
              {%- if mobile_video != blank -%}
                <video
                  class="rf-arrival-editorial-showcase__video"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  {%- if mobile_image != blank %} poster="{{ mobile_image | image_url: width: 1000 }}"{% endif -%}
                >
                  {%- for source in mobile_video.sources -%}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {%- endfor -%}
                  {%- if mobile_image != blank -%}
                    {{
                      mobile_image
                      | image_url: width: 1000
                      | image_tag:
                        class: 'rf-arrival-editorial-showcase__image',
                        widths: '500, 750, 1000',
                        sizes: '100vw',
                        loading: 'lazy',
                        alt: block.settings.image_alt
                    }}
                  {%- endif -%}
                </video>
              {%- elsif mobile_image != blank -%}
                {{
                  mobile_image
                  | image_url: width: 1000
                  | image_tag:
                    class: 'rf-arrival-editorial-showcase__image',
                    widths: '500, 750, 1000',
                    sizes: '100vw',
                    loading: 'lazy',
                    alt: block.settings.image_alt
                }}
              {%- elsif desktop_video != blank -%}
                <video
                  class="rf-arrival-editorial-showcase__video"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  {%- if desktop_image != blank %} poster="{{ desktop_image | image_url: width: 1000 }}"{% endif -%}
                >
                  {%- for source in desktop_video.sources -%}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {%- endfor -%}
                </video>
              {%- elsif desktop_image != blank -%}
                {{
                  desktop_image
                  | image_url: width: 1000
                  | image_tag:
                    class: 'rf-arrival-editorial-showcase__image',
                    widths: '500, 750, 1000',
                    sizes: '100vw',
                    loading: 'lazy',
                    alt: block.settings.image_alt
                }}
              {%- else -%}
                <div class="rf-arrival-editorial-showcase__placeholder" aria-hidden="true"></div>
              {%- endif -%}
            </div>
          </div>

          <div class="rf-arrival-editorial-showcase__content">
            <div class="rf-arrival-editorial-showcase__copy">
              {%- if block.settings.eyebrow != blank -%}
                <p class="rf-arrival-editorial-showcase__eyebrow">{{ block.settings.eyebrow | escape }}</p>
              {%- endif -%}

              {%- if heading_text != blank -%}
                <h2 class="rf-arrival-editorial-showcase__heading">{{ heading_text | escape }}</h2>
              {%- endif -%}

              {%- if subheading_text != blank -%}
                <p class="rf-arrival-editorial-showcase__subheading">{{ subheading_text | escape }}</p>
              {%- endif -%}

              {%- if block.settings.body != blank -%}
                <div class="rf-arrival-editorial-showcase__body">{{ block.settings.body }}</div>
              {%- endif -%}
            </div>

            {%- if block.settings.cta_label != blank -%}
              <span class="rf-arrival-editorial-showcase__cta action_btn">
                <span class="button11">{{ block.settings.cta_label | escape }}</span>
              </span>
            {%- endif -%}
          </div>

          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "RF Arrival editorial",
  "class": "shopify-section--rf-arrival-editorial",
  "max_blocks": 3,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "desktop_images_include_text",
      "label": "Desktop media already includes text",
      "info": "Turn this on only when all three desktop media items already contain their text and CTA. Dynamic HTML content will be hidden in all three columns.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "mobile_images_include_text",
      "label": "Mobile media already includes text",
      "info": "Turn this on only when all three mobile media items already contain their text and CTA.",
      "default": false
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Featured collections"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature panel",
      "settings": [
        {
          "type": "select",
          "id": "layout_style",
          "label": "Layout style",
          "options": [
            {
              "value": "split-left",
              "label": "Text panel left, image right"
            },
            {
              "value": "overlay-top",
              "label": "Text over image, top"
            },
            {
              "value": "overlay-bottom",
              "label": "Text over image, bottom"
            }
          ],
          "default": "overlay-top"
        },
        {
          "type": "select",
          "id": "text_tone",
          "label": "Text tone",
          "options": [
            {
              "value": "dark",
              "label": "Dark"
            },
            {
              "value": "light",
              "label": "Light"
            }
          ],
          "default": "dark"
        },
        {
          "type": "video",
          "id": "desktop_video",
          "label": "Desktop video",
          "info": "Optional. When selected, the video is used instead of the desktop image."
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image / video fallback",
          "info": "Used when there is no desktop video and as the video poster/fallback when a video is selected."
        },
        {
          "type": "checkbox",
          "id": "desktop_image_includes_text",
          "label": "Desktop media already includes text",
          "info": "Turn this on when the selected desktop video or image already contains the heading/body text. The dynamic button remains visible and configurable.",
          "default": false
        },
        {
          "type": "video",
          "id": "mobile_video",
          "label": "Mobile video",
          "info": "Optional. When selected, the video is used instead of the mobile image."
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image / video fallback",
          "info": "Used when there is no mobile video and as the mobile video poster/fallback."
        },
        {
          "type": "checkbox",
          "id": "mobile_image_includes_text",
          "label": "Mobile media already includes text",
          "info": "Turn this on when the selected mobile video or image already contains the heading/body text. The dynamic button remains visible and configurable.",
          "default": false
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Primary heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Secondary heading"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RF Arrival editorial",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "layout_style": "split-left",
            "text_tone": "dark",
            "eyebrow": "FEATURED",
            "heading": "DRINK",
            "subheading": "TABLES",
            "body": "<p>Sculptural details for every corner</p>",
            "cta_label": "EXPLORE DRINK TABLES"
          }
        },
        {
          "type": "feature",
          "settings": {
            "layout_style": "overlay-top",
            "text_tone": "dark",
            "heading": "ORBIT",
            "subheading": "SCULPTURE",
            "body": "<p>RIBBONS OF BRONZE<br>RESTING ON MARBLE</p>",
            "cta_label": "EXPLORE DECOR"
          }
        },
        {
          "type": "feature",
          "settings": {
            "layout_style": "overlay-bottom",
            "text_tone": "dark",
            "heading": "FLARE",
            "subheading": "WALL SCONCE",
            "cta_label": "EXPLORE WALL LIGHTS"
          }
        }
      ]
    }
  ]
}
{% endschema %}
