{{ 'rf-home-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'rf-home-hero.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign slide_count = section.blocks.size
  assign autoplay_delay = section.settings.autoplay_delay | times: 1000
-%}

<rf-home-hero
  id="RFHomeHero-{{ section.id }}"
  class="rf-home-hero"
  data-section-id="{{ section.id }}"
  data-slide-count="{{ slide_count }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-delay="{{ autoplay_delay }}"
  {{ section.shopify_attributes }}
>
  <div class="rf-home-hero__slider swiper" aria-roledescription="carousel" aria-label="{{ section.settings.accessibility_label | escape }}">
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        {%- liquid
          assign desktop_image = block.settings.desktop_image
          assign mobile_image = block.settings.mobile_image | default: desktop_image
          if desktop_image == blank
            assign desktop_image = mobile_image
          endif
          assign desktop_video = block.settings.desktop_video
          assign mobile_video = block.settings.mobile_video | default: desktop_video
          if desktop_video == blank
            assign desktop_video = mobile_video
          endif
          assign loading = 'lazy'
          assign fetchpriority = 'auto'
          if forloop.first
            assign loading = 'eager'
            assign fetchpriority = 'high'
          endif
        -%}

        <div
          class="rf-home-hero__slide swiper-slide{% if block.settings.desktop_image_includes_text %} rf-home-hero__slide--desktop-artwork{% endif %}{% if block.settings.mobile_image_includes_text %} rf-home-hero__slide--mobile-artwork{% endif %}"
          data-block-id="{{ block.id }}"
          style="--rf-hero-text: {{ block.settings.text_color }}; --rf-hero-offer: {{ block.settings.offer_color }}; --rf-hero-overlay: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} of {{ slide_count }}"
          {{ block.shopify_attributes }}
        >
          <div class="rf-home-hero__media" aria-hidden="true">
            {%- if desktop_video != blank or mobile_video != blank -%}
              {%- if desktop_video != blank -%}
                {{ desktop_video | video_tag: class: 'rf-home-hero__video rf-home-hero__video--desktop', image_size: '2000x', autoplay: false, loop: true, muted: true, controls: false, playsinline: true, preload: 'none' }}
              {%- endif -%}
              {%- if mobile_video != blank -%}
                {{ mobile_video | video_tag: class: 'rf-home-hero__video rf-home-hero__video--mobile', image_size: '900x', autoplay: false, loop: true, muted: true, controls: false, playsinline: true, preload: 'none' }}
              {%- endif -%}
            {%- elsif desktop_image != blank or mobile_image != blank -%}
              <picture>
                {%- if mobile_image != blank -%}
                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {{ mobile_image | image_url: width: 450 }} 450w,
                      {{ mobile_image | image_url: width: 750 }} 750w,
                      {{ mobile_image | image_url: width: 900 }} 900w
                    "
                    sizes="100vw"
                  >
                {%- endif -%}
                {{
                  desktop_image
                  | image_url: width: 2400
                  | image_tag:
                    class: 'rf-home-hero__image',
                    widths: '750, 1100, 1500, 1800, 2200, 2400',
                    sizes: '100vw',
                    loading: loading,
                    fetchpriority: fetchpriority,
                    alt: block.settings.image_alt
                }}
              </picture>
            {%- else -%}
              <div class="rf-home-hero__media-placeholder"></div>
            {%- endif -%}
          </div>

          <div class="rf-home-hero__shade"></div>

          <div class="rf-home-hero__content rf-home-hero__content--{{ block.settings.content_position }}">
            <div class="rf-home-hero__copy">
              {%- if block.settings.heading != blank -%}
                {%- if forloop.first -%}
                  <h1 class="rf-home-hero__heading">{{ block.settings.heading | escape }}</h1>
                {%- else -%}
                  <h2 class="rf-home-hero__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
              {%- endif -%}

              {%- if block.settings.subheading != blank -%}
                <p class="rf-home-hero__subheading">{{ block.settings.subheading | escape }}</p>
              {%- endif -%}

              {%- if block.settings.date_text != blank -%}
                <p class="rf-home-hero__date">{{ block.settings.date_text | escape }}</p>
              {%- endif -%}

              {%- if block.settings.offer_text != blank -%}
                <p class="rf-home-hero__offer">{{ block.settings.offer_text | escape }}</p>
              {%- endif -%}

              {%- if block.settings.offer_supporting_text != blank -%}
                <p class="rf-home-hero__offer-supporting">{{ block.settings.offer_supporting_text | escape }}</p>
              {%- endif -%}

              {%- if block.settings.button_label != blank -%}
                <a
                  class="rf-home-hero__button{% unless block.settings.show_button_desktop %} rf-home-hero__button--mobile-only{% endunless %}"
                  {% if block.settings.button_link != blank %}
                    href="{{ block.settings.button_link }}"
                  {% else %}
                    role="link"
                    aria-disabled="true"
                  {% endif %}
                >
                  {{ block.settings.button_label | escape }}
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if slide_count > 1 -%}
      <button class="rf-home-hero__arrow rf-home-hero__arrow--previous" type="button" aria-label="Previous slide" title="Previous slide">
        <span aria-hidden="true">&#8592;</span>
      </button>
      <button class="rf-home-hero__arrow rf-home-hero__arrow--next" type="button" aria-label="Next slide" title="Next slide">
        <span aria-hidden="true">&#8594;</span>
      </button>

      <div class="rf-home-hero__controls">
        <div class="rf-home-hero__pagination" aria-label="Choose a slide"></div>
        {%- if section.settings.autoplay -%}
          <button class="rf-home-hero__playback" type="button" aria-label="Pause slideshow" title="Pause slideshow">
            <span class="rf-home-hero__pause-icon" aria-hidden="true"><i></i><i></i></span>
            <span class="rf-home-hero__play-icon" aria-hidden="true"></span>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</rf-home-hero>

{% schema %}
{
  "name": "RF Home hero",
  "tag": "section",
  "class": "rf-home-hero-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Slideshow label",
      "default": "Homepage campaign"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 3,
      "max": 9,
      "step": 1,
      "unit": "s",
      "label": "Time between slides",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Desktop media"
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "video",
          "id": "desktop_video",
          "label": "Desktop video"
        },
        {
          "type": "checkbox",
          "id": "desktop_image_includes_text",
          "label": "Desktop image already includes campaign text",
          "info": "Turn this on when the uploaded desktop artwork already contains the heading, offer and CTA. Mobile text stays dynamic.",
          "default": false
        },
        {
          "type": "header",
          "content": "Mobile media"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "video",
          "id": "mobile_video",
          "label": "Mobile video"
        },
        {
          "type": "checkbox",
          "id": "mobile_image_includes_text",
          "label": "Mobile image already includes campaign text",
          "info": "Turn this on only when the uploaded mobile artwork already contains the heading, offer and CTA. Desktop is controlled separately.",
          "default": false
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "ARRIVE"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "the season of considered arrivals"
        },
        {
          "type": "text",
          "id": "date_text",
          "label": "Date text",
          "default": "11 OCT - 10 NOV"
        },
        {
          "type": "text",
          "id": "offer_text",
          "label": "Offer",
          "default": "25% OFF"
        },
        {
          "type": "text",
          "id": "offer_supporting_text",
          "label": "Offer supporting text",
          "default": "SITEWIDE"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "SHOP THE SALE"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "show_button_desktop",
          "label": "Show button on desktop",
          "default": false
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "options": [
            { "value": "center", "label": "Center" },
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#f4f0e8"
        },
        {
          "type": "color",
          "id": "offer_color",
          "label": "Offer color",
          "default": "#d97568"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 70,
          "step": 5,
          "unit": "%",
          "label": "Dark overlay",
          "default": 20
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RF Home hero",
      "blocks": [
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
