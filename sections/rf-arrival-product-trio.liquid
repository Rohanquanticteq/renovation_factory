{{ 'rf-arrival-product-trio.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_section -%}
  <section
    class="rf-arrival-product-trio"
    aria-label="{{ section.settings.accessibility_label | escape }}"
    {{ section.shopify_attributes }}
  >
    <div class="rf-arrival-product-trio__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign desktop_image = block.settings.desktop_image
          assign mobile_image = block.settings.mobile_image | default: desktop_image
          if desktop_image == blank
            assign desktop_image = mobile_image
          endif
        -%}

        {%- capture card_classes -%}
          rf-arrival-product-trio__card
          {%- if block.settings.desktop_image_includes_text %} rf-arrival-product-trio__card--desktop-artwork{% endif -%}
          {%- if block.settings.mobile_image_includes_text %} rf-arrival-product-trio__card--mobile-artwork{% endif -%}
        {%- endcapture -%}

        {%- if block.settings.link != blank -%}
          <a class="{{ card_classes | strip }}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        {%- else -%}
          <div class="{{ card_classes | strip }}" {{ block.shopify_attributes }}>
        {%- endif -%}

          <div class="rf-arrival-product-trio__media">
            {%- if desktop_image != blank -%}
              <picture>
                {%- if mobile_image != blank -%}
                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {{ mobile_image | image_url: width: 500 }} 500w,
                      {{ mobile_image | image_url: width: 750 }} 750w,
                      {{ mobile_image | image_url: width: 1000 }} 1000w
                    "
                    sizes="100vw"
                  >
                {%- endif -%}

                {{
                  desktop_image
                  | image_url: width: 1400
                  | image_tag:
                    class: 'rf-arrival-product-trio__image',
                    widths: '500, 750, 1000, 1200, 1400',
                    sizes: '(min-width: 750px) 33.333vw, 100vw',
                    loading: 'lazy',
                    alt: block.settings.image_alt
                }}
              </picture>
            {%- else -%}
              <div class="rf-arrival-product-trio__placeholder" aria-hidden="true"></div>
            {%- endif -%}
          </div>

          <span class="rf-arrival-product-trio__shade" aria-hidden="true"></span>

          <div class="rf-arrival-product-trio__content">
            {%- if block.settings.heading != blank -%}
              <h2 class="rf-arrival-product-trio__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}

            {%- if block.settings.cta_label != blank -%}
              <span class="rf-arrival-product-trio__cta">
                {{ block.settings.cta_label | escape }}
                <span aria-hidden="true">&rarr;</span>
              </span>
            {%- endif -%}
          </div>

        {%- if block.settings.link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "RF Arrival product trio",
  "class": "shopify-section--rf-arrival-product-trio",
  "max_blocks": 3,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Featured products"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature card",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "checkbox",
          "id": "desktop_image_includes_text",
          "label": "Desktop image already includes text",
          "info": "Turn this on when the desktop artwork already contains the title and CTA. The separate HTML text and overlay will be hidden on desktop.",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "checkbox",
          "id": "mobile_image_includes_text",
          "label": "Mobile image already includes text",
          "info": "Turn this on when the mobile artwork already contains the title and CTA. The separate HTML text and overlay will be hidden on mobile.",
          "default": false
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RF Arrival product trio",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "heading": "DWINE CANDLEHOLDERS",
            "cta_label": "SHOP NOW"
          }
        },
        {
          "type": "feature",
          "settings": {
            "heading": "TROY LINK PENDANT",
            "cta_label": "SHOP NOW"
          }
        },
        {
          "type": "feature",
          "settings": {
            "heading": "ARDOR SIDE TABLE",
            "cta_label": "SHOP NOW"
          }
        }
      ]
    }
  ]
}
{% endschema %}
