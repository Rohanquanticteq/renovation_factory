{% if section.settings.display_collection_single_banner != blank %}
<div class="mainSliderSec collectionSlideshow collectionSingleBanner">
  {% if section.settings.desktop_banner != blank or section.settings.mobile_banner != blank %}
  <div class="img_d">
    <img src="{{ section.settings.desktop_banner | img_url:"master" }}" class="hidden-xs">
    <img src="{{ section.settings.mobile_banner | img_url:"master" }}" class="visible-xs">
  </div>
  {% endif %}
</div>
{% endif %}



{% schema %}
{
  "name": "Collection Single Banner",
  "class": "section",
  "settings": [
     {
        "type": "checkbox",
        "id": "display_collection_single_banner",
        "label": "Display Collection Single Banner",
        "default": true
    },
     {
          "type": "image_picker",
          "id": "desktop_banner",
          "label": "Desktop Banner"
        },
        {
          "type": "image_picker",
          "id": "mobile_banner",
          "label": "Mobile Banner"
        }
  ],
  "presets": [
    {
      "name": "Collection Single Banner"
    }
  ]
}
{% endschema %}
