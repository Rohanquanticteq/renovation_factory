{{ 'rf-living-spaces.css' | asset_url | stylesheet_tag }}

<section class="rf-living-spaces" aria-labelledby="RFLivingSpacesTitle-{{ section.id }}" {{ section.shopify_attributes }}>
  <header class="rf-living-spaces__header">
    <h2 id="RFLivingSpacesTitle-{{ section.id }}" class="rf-living-spaces__heading">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.view_all_label != blank -%}
      <a
        class="rf-living-spaces__view-all"
        {% if section.settings.view_all_link != blank %}href="{{ section.settings.view_all_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
      >
        {{ section.settings.view_all_label | escape }}
      </a>
    {%- endif -%}
  </header>

  <div class="rf-living-spaces__rail" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign desktop_image = block.settings.desktop_image
        assign mobile_image = block.settings.mobile_image | default: desktop_image
        if desktop_image == blank
          assign desktop_image = mobile_image
        endif
      -%}
      <a
        class="rf-living-spaces__card{% if block.settings.desktop_image_includes_text %} rf-living-spaces__card--desktop-artwork{% endif %}{% if block.settings.mobile_image_includes_text %} rf-living-spaces__card--mobile-artwork{% endif %}"
        {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %}
        role="listitem"
        {{ block.shopify_attributes }}
      >
        {%- if desktop_image != blank -%}
          <picture>
            {%- if mobile_image != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="{{ mobile_image | image_url: width: 400 }} 400w, {{ mobile_image | image_url: width: 700 }} 700w"
                sizes="64vw"
              >
            {%- endif -%}
            {{
              desktop_image
              | image_url: width: 1000
              | image_tag:
                class: 'rf-living-spaces__image',
                widths: '400, 600, 800, 1000',
                sizes: '(min-width: 750px) 25vw, 64vw',
                loading: 'lazy',
                alt: block.settings.image_alt
            }}
          </picture>
        {%- else -%}
          <span class="rf-living-spaces__placeholder" aria-hidden="true"></span>
        {%- endif -%}

        {%- if block.settings.placeholder_label != blank -%}
          <span class="rf-living-spaces__media-label">{{ block.settings.placeholder_label | escape }}</span>
        {%- endif -%}
        <span class="rf-living-spaces__shade" aria-hidden="true"></span>
        <span class="rf-living-spaces__title">{{ block.settings.title | escape }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "RF Living spaces",
  "class": "shopify-section--rf-living-spaces",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Living Spaces" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "VIEW ALL" },
    { "type": "url", "id": "view_all_link", "label": "View all link" }
  ],
  "blocks": [
    {
      "type": "space",
      "name": "Living space",
      "settings": [
        { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
        {
          "type": "checkbox",
          "id": "desktop_image_includes_text",
          "label": "Desktop image already includes text",
          "info": "Turn this on when the uploaded desktop image already contains the living-space title. The theme title and overlay are hidden on desktop.",
          "default": false
        },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
        {
          "type": "checkbox",
          "id": "mobile_image_includes_text",
          "label": "Mobile image already includes text",
          "info": "Turn this on when the uploaded mobile image already contains the living-space title. The theme title and overlay are hidden on mobile.",
          "default": false
        },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "placeholder_label", "label": "Media label" },
        { "type": "text", "id": "title", "label": "Title", "default": "Living room" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "RF Living spaces",
      "blocks": [
        { "type": "space", "settings": { "title": "Living room" } },
        { "type": "space", "settings": { "title": "Dining room" } },
        { "type": "space", "settings": { "title": "Bedroom" } },
        { "type": "space", "settings": { "title": "Entryway" } }
      ]
    }
  ]
}
{% endschema %}
