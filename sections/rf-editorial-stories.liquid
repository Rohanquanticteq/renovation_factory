{{ 'rf-editorial-stories.css' | asset_url | stylesheet_tag }}

<section class="rf-editorial-stories" aria-label="{{ section.settings.accessibility_label | escape }}" {{ section.shopify_attributes }}>
  <div class="rf-editorial-stories__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign desktop_image = block.settings.desktop_image
        assign mobile_image = block.settings.mobile_image | default: desktop_image
        if desktop_image == blank
          assign desktop_image = mobile_image
        endif
      -%}
      <article class="rf-editorial-story rf-editorial-story--{{ block.settings.color_scheme }}" {{ block.shopify_attributes }}>
        <div class="rf-editorial-story__media">
          {%- if desktop_image != blank -%}
            <picture>
              {%- if mobile_image != blank -%}
                <source
                  media="(max-width: 749px)"
                  srcset="
                    {{ mobile_image | image_url: width: 450 }} 450w,
                    {{ mobile_image | image_url: width: 750 }} 750w,
                    {{ mobile_image | image_url: width: 900 }} 900w
                  "
                  sizes="calc(100vw - 40px)"
                >
              {%- endif -%}
              {{
                desktop_image
                | image_url: width: 1400
                | image_tag:
                  class: 'rf-editorial-story__image',
                  widths: '600, 900, 1200, 1400',
                  sizes: '(min-width: 750px) 50vw, calc(100vw - 40px)',
                  loading: 'lazy',
                  alt: block.settings.image_alt
              }}
            </picture>
          {%- else -%}
            <div class="rf-editorial-story__placeholder" aria-hidden="true"></div>
          {%- endif -%}

          {%- if block.settings.placeholder_label != blank -%}
            <span class="rf-editorial-story__media-label">{{ block.settings.placeholder_label | escape }}</span>
          {%- endif -%}
        </div>

        <div class="rf-editorial-story__content">
          {%- if block.settings.eyebrow != blank -%}
            <p class="rf-editorial-story__eyebrow">{{ block.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 class="rf-editorial-story__title">{{ block.settings.heading | escape }}</h2>
          {%- if block.settings.body != blank -%}
            <div class="rf-editorial-story__body">{{ block.settings.body }}</div>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a
              class="rf-editorial-story__button"
              {% if block.settings.button_link != blank %}href="{{ block.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
            >
              {{ block.settings.button_label | escape }}
              <span aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "RF Editorial stories",
  "class": "shopify-section--rf-editorial-stories",
  "max_blocks": 2,
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Featured stories"
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [
        { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "placeholder_label", "label": "Media label" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Featured story" },
        { "type": "richtext", "id": "body", "label": "Body" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "EXPLORE DETAILS" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        {
          "type": "select",
          "id": "color_scheme",
          "label": "Color scheme",
          "options": [
            { "value": "light", "label": "Light" },
            { "value": "dark", "label": "Dark" }
          ],
          "default": "light"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RF Editorial stories",
      "blocks": [
        { "type": "story" },
        { "type": "story", "settings": { "color_scheme": "dark" } }
      ]
    }
  ]
}
{% endschema %}
